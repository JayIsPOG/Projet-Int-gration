<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">

    <!-- Wave Label -->
    <ui:VisualElement style="position: absolute; top: 20px; left: 20px; background-color: rgba(10, 10, 20, 0.8); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(180, 140, 40); border-right-color: rgb(180, 140, 40); border-top-color: rgb(180, 140, 40); border-bottom-color: rgb(180, 140, 40); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; padding-left: 20px; padding-right: 20px; padding-top: 6px; padding-bottom: 6px;">
        <ui:Label name="WaveLabel" text="Wave 1/5" style="font-size: 30px; color: rgb(255, 215, 90); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; -unity-text-align: middle-center; -unity-font-style: bold;" />
    </ui:VisualElement>

    <!-- Hearts -->
    <ui:VisualElement name="HeartsContainer" style="position: absolute; top: 20px; right: 20px; background-color: rgba(10, 10, 20, 0.8); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(180, 40, 40); border-right-color: rgb(180, 40, 40); border-top-color: rgb(180, 40, 40); border-bottom-color: rgb(180, 40, 40); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; flex-direction: row; align-items: center; justify-content: center;">
        <ui:VisualElement name="Heart" style="width: 64px; height: 64px; background-image: url(&apos;project://database/Assets/HealthHeartSystem/Graphics/mini-heart.png?fileID=21300000&amp;guid=fed24bd82cefc0c4a8ef64dab6231b53&amp;type=3#mini-heart_0&apos;); margin-right: 6px;" />
        <ui:VisualElement name="Heart" style="width: 64px; height: 64px; background-image: url(&apos;project://database/Assets/HealthHeartSystem/Graphics/mini-heart.png?fileID=21300000&amp;guid=fed24bd82cefc0c4a8ef64dab6231b53&amp;type=3#mini-heart_0&apos;); margin-right: 6px;" />
        <ui:VisualElement name="Heart" style="width: 64px; height: 64px; background-image: url(&apos;project://database/Assets/HealthHeartSystem/Graphics/mini-heart.png?fileID=21300000&amp;guid=fed24bd82cefc0c4a8ef64dab6231b53&amp;type=3#mini-heart_0&apos;);" />
    </ui:VisualElement>

    <!-- Victory Panel -->
    <ui:VisualElement name="VictoryPanel" picking-mode="Position" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7);">
        <ui:VisualElement picking-mode="Position" style="background-color: rgba(10, 30, 10, 0.95); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(80, 200, 80); border-right-color: rgb(80, 200, 80); border-top-color: rgb(80, 200, 80); border-bottom-color: rgb(80, 200, 80); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; padding-left: 60px; padding-right: 60px; padding-top: 40px; padding-bottom: 40px; align-items: center;">
            <ui:Label text="Victoire!" style="font-size: 50px; color: rgb(100, 255, 100); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-font-style: bold; margin-bottom: 30px;" />
            <ui:Button name="VictoryReplayButton" text="Rejouer" picking-mode="Position" focusable="true" style="font-size: 28px; color: rgb(255, 255, 255); background-color: rgb(40, 120, 40); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(80, 200, 80); border-right-color: rgb(80, 200, 80); border-top-color: rgb(80, 200, 80); border-bottom-color: rgb(80, 200, 80); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-left: 30px; padding-right: 30px; padding-top: 12px; padding-bottom: 12px; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Defeat Panel -->
    <ui:VisualElement name="DefeatPanel" picking-mode="Position" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7);">
        <ui:VisualElement picking-mode="Position" style="background-color: rgba(30, 10, 10, 0.95); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(200, 50, 50); border-right-color: rgb(200, 50, 50); border-top-color: rgb(200, 50, 50); border-bottom-color: rgb(200, 50, 50); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; padding-left: 60px; padding-right: 60px; padding-top: 40px; padding-bottom: 40px; align-items: center;">
            <ui:Label text="Defaite..." style="font-size: 50px; color: rgb(255, 80, 80); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; -unity-font-style: bold; margin-bottom: 30px;" />
            <ui:Button name="DefeatReplayButton" text="Rejouer" picking-mode="Position" focusable="true" style="font-size: 28px; color: rgb(255, 255, 255); background-color: rgb(140, 30, 30); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(200, 50, 50); border-right-color: rgb(200, 50, 50); border-top-color: rgb(200, 50, 50); border-bottom-color: rgb(200, 50, 50); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-left: 30px; padding-right: 30px; padding-top: 12px; padding-bottom: 12px; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
